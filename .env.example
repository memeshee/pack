# DogeOS SDK client ID (public) — create a project at https://console.dogeos.com
# Use the Sandbox ID in development and register your deployed origin (scheme + host + port).
# When set, Pack uses DogeOS embedded wallets (email / Google / X). When empty, it falls back to browser wallets.
VITE_DOGEOS_CLIENT_ID=

# WalletConnect Cloud project id — create one free at https://cloud.reown.com
# Optional. Required for WalletConnect / mobile wallets.
VITE_WALLETCONNECT_PROJECT_ID=

# Public origin for og:image / twitter:image (no trailing slash), e.g. https://pack.vercel.app
# Optional on Vercel: VERCEL_PROJECT_PRODUCTION_URL is used when this is empty.
VITE_SITE_URL=
